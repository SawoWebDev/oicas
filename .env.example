# Copy to .env and fill in. Never commit .env.

# development | production   (production refuses to start with unsafe settings)
APP_ENV=development
APP_TIMEZONE=Asia/Manila
# 32+ random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-before-production
POSTGRES_PASSWORD=change-me
OICAS_PORT=8086
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
SESSION_HOURS=10
SESSION_IDLE_MINUTES=120

# Odoo (read-only) — this switch also selects the database:
#   live → real Odoo; login with your Odoo username/email + password; PRIMARY database (oicas)
#   fake → simulated Odoo with demo accounts (admin/manager/counter/viewer, password "demo");
#          SECONDARY demo database (oicas_demo)
# Both database URLs are set in compose.yaml (DATABASE_URL = primary, DEMO_DATABASE_URL = secondary).
# After changing ODOO_MODE run:  docker compose up -d
ODOO_MODE=fake
ODOO_URL=https://odoo.example.com
ODOO_DB=production
# Only ODOO_URL + ODOO_DB are needed. Users log in with their ERP login, and "Sync Odoo now" reads
# Odoo with the logged-in user's own ERP login (no API key, no service account). OICAS is read-only.
# OPTIONAL: an ERP login/password for an unattended hourly sync by the worker. Leave empty to sync from the screen.
ODOO_SYNC_LOGIN=
ODOO_SYNC_PASSWORD=
ODOO_TIMEOUT_SECONDS=60
ODOO_PAGE_SIZE=1000
SYNC_INTERVAL_MINUTES=60

# Optional break-glass local admin (used only when Odoo login is unavailable). Leave empty to disable.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
